        "matrix[::2, 1::2] = 1\n",
        "matrix[1::2, ::2] = 1\n",
        "\n",
        "# Print the checkerboard pattern\n",
        "for i in range(n):\n",
        "    for j in range(n):\n",
        "        print(matrix[i][j], end=\" \")\n",
        "    print()"
